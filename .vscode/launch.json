{
    "configurations": [
        {
            "name": "Input: _test.txt",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "<",
                "${fileDirname}/${input:adventDayName}_test.txt"
            ]
        },
        {
            "name": "Input: _example.txt",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "<",
                "${fileDirname}/${input:adventDayName}_example.txt"
            ]
        }
    ],


    "inputs": [
        {
            "id": "adventDayName",
            "type": "command",
            "command": "extension.commandvariable.transform",
            "args": {
                "text": "${fileBasenameNoExtension}",
                "apply": [
                    { "find": "(day_\\d{2}).*$", "replace": "$1", "flags": "" }
                ],
                "transform": {}
            }
        }
    ]
}

